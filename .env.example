# ---------- Backend (copy to backend/.env) ----------
APP_ENV=development
# SQLite for zero-setup local dev; use Postgres in docker/prod:
# DATABASE_URL=postgresql+psycopg://fitscan:fitscan@localhost:5432/fitscan
DATABASE_URL=sqlite:///./fitscan.db
FRONTEND_ORIGIN=http://localhost:3000

# Storage: "local" (./storage) or "s3" (MinIO / S3 / R2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fitscan-documents
SIGNED_URL_TTL_SECONDS=300

# Upload limits (FR-UPL-3)
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=30

# Extraction (FR-LAB-7)
CONFIDENCE_THRESHOLD=0.85

# Auth (Phase 4)
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
# Admin panel (/admin): comma-separated emails of registered accounts allowed in. Empty = nobody.
ADMIN_EMAILS=
# Weekly summary email to the owners via https://resend.com (free). Empty = not sent; preview still in /admin.
RESEND_API_KEY=
EMAIL_FROM=FITSCAN <onboarding@resend.dev>
WEEKLY_SUMMARY_WEEKDAY=0
GUEST_RETENTION_HOURS=24

# LLM (Phase 3) - Anthropic Messages API. Leave the key empty to use offline template explanations.
# ANTHROPIC_API_KEY is also honoured.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Centre provider (Phase 3)
CENTRE_PROVIDER=google
GOOGLE_PLACES_API_KEY=

# ---------- Frontend (copy to frontend/.env.local) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
